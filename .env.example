# ML Stock Predictor Platform - Environment Configuration

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_DATABASE_URL=postgresql://trading_user:secure_password123@localhost:5432/trading_system
DB_TIMESCALE_URL=postgresql://trading_user:secure_password123@localhost:5432/trading_system
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_CHUNK_TIME_INTERVAL=1 day
DB_COMPRESSION_ENABLED=true
DB_COMPRESSION_AFTER=7 days

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_REDIS_URL=redis://localhost:6379
REDIS_CELERY_BROKER_URL=redis://localhost:6379/0
REDIS_CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_CACHE_TTL=300
REDIS_PREDICTION_CACHE_TTL=60

# =============================================================================
# DATA COLLECTION CONFIGURATION
# =============================================================================
DATA_YAHOO_FINANCE_ENABLED=true
DATA_ALPHA_VANTAGE_ENABLED=true
DATA_POLYGON_ENABLED=false
DATA_YAHOO_FINANCE_API_KEY=
DATA_ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
DATA_POLYGON_API_KEY=
DATA_REQUESTS_PER_MINUTE=60
DATA_REQUESTS_PER_SECOND=5
DATA_REAL_TIME_INTERVAL=1
DATA_HISTORICAL_INTERVAL=3600
DATA_DATA_RETENTION_DAYS=1095
DATA_WEBSOCKET_ENABLED=false
DATA_WEBSOCKET_URL=wss://stream.data.alpaca.markets/v2/iex
DATA_WEBSOCKET_API_KEY=
DATA_WEBSOCKET_API_SECRET=
DATA_DEFAULT_TIMEFRAMES=["1d", "1h", "15m", "5m", "1m"]
DATA_BATCH_SIZE=1000
DATA_COLLECTION_INTERVAL_MINUTES=5

# =============================================================================
# MACHINE LEARNING CONFIGURATION
# =============================================================================
ML_MODEL_CACHE_DIR=./models
ML_MODEL_VERSIONING=true
ML_TRAINING_BATCH_SIZE=32
ML_TRAINING_EPOCHS=100
ML_EARLY_STOPPING_PATIENCE=10
ML_LSTM_UNITS=50
ML_LSTM_LAYERS=2
ML_LSTM_DROPOUT=0.2
ML_RF_N_ESTIMATORS=100
ML_RF_MAX_DEPTH=10
ML_XGB_LEARNING_RATE=0.1
ML_XGB_MAX_DEPTH=6

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=30
API_RATE_LIMIT_PER_MINUTE=100
API_ALLOWED_ORIGINS=["*"]

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
MONITORING_LOG_LEVEL=INFO
MONITORING_LOG_FILE=./logs/app.log
MONITORING_LOG_FORMAT=json
MONITORING_METRICS_ENABLED=true
MONITORING_METRICS_PORT=9090
MONITORING_HEALTH_CHECK_INTERVAL=30
MONITORING_ALERT_WEBHOOK_URL=
MONITORING_ALERT_EMAIL=

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
ENVIRONMENT=development
APP_NAME=ML Stock Predictor Platform
APP_VERSION=1.0.0

# =============================================================================
# TRADING CONFIGURATION
# =============================================================================
TRADING_DEFAULT_CURRENCY=USD
TRADING_MAX_POSITION_SIZE=1000000
TRADING_RISK_LIMIT=0.02
TRADING_HOURS_START=09:30
TRADING_HOURS_END=16:00
TRADING_TIMEZONE=America/New_York

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
SECURITY_JWT_SECRET=your-jwt-secret-here
SECURITY_JWT_EXPIRY=3600
SECURITY_BCRYPT_ROUNDS=12
SECURITY_RATE_LIMIT=1000
SECURITY_CORS_ORIGINS=["*"]